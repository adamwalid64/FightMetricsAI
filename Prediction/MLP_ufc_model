# -----------------------
# Torch Dataset / Loaders
# -----------------------
class NPDataset(Dataset):
    def __init__(self, X, y):
        self.X = torch.tensor(X, dtype=torch.float32)
        self.y = torch.tensor(y, dtype=torch.float32)  # BCEWithLogitsLoss expects float targets
    def __len__(self): return self.X.shape[0]
    def __getitem__(self, i): return self.X[i], self.y[i]

train_ds = NPDataset(X_tr, y_tr)
val_ds   = NPDataset(X_val, y_val)
test_ds  = NPDataset(X_te, y_te)

def make_loaders(batch_size=256):
    return (
        DataLoader(train_ds, batch_size=batch_size, shuffle=True),
        DataLoader(val_ds,   batch_size=batch_size, shuffle=False),
        DataLoader(test_ds,  batch_size=batch_size, shuffle=False),
    )

# -----------------------
# MLP model (BatchNorm + Dropout)
# -----------------------
class MLP(nn.Module):
    def __init__(self, in_dim: int, hidden=(128,64,32), dropout=0.15):
        super().__init__()
        layers = []
        prev = in_dim
        for h in hidden:
            layers += [nn.Linear(prev, h), nn.BatchNorm1d(h), nn.ReLU(), nn.Dropout(dropout)]
            prev = h
        layers += [nn.Linear(prev, 1)]  # binary logit
        self.net = nn.Sequential(*layers)
    def forward(self, x):
        return self.net(x).squeeze(1)

# -----------------------
# Class imbalance -> pos_weight (for Red=1)
# -----------------------
pos = (y_tr == 1).sum()
neg = (y_tr == 0).sum()
pos_weight = None
if pos > 0 and neg > 0:
    pos_weight = torch.tensor([neg / max(pos, 1)], dtype=torch.float32, device=DEVICE)

# -----------------------
# Evaluation helper
# -----------------------
@torch.no_grad()
def evaluate(model: nn.Module, loader: DataLoader):
    model.eval()
    all_logits, all_true = [], []
    for xb, yb in loader:
        xb = xb.to(DEVICE); yb = yb.to(DEVICE)
        logits = model(xb)
        all_logits.append(logits.cpu().numpy())
        all_true.append(yb.cpu().numpy())
    logits = np.concatenate(all_logits)
    probs  = 1.0 / (1.0 + np.exp(-logits))
    preds  = (probs >= 0.5).astype(int)
    y_true = np.concatenate(all_true).astype(int)
    return {
        "acc":  accuracy_score(y_true, preds),
        "bacc": balanced_accuracy_score(y_true, preds),
        "f1m":  f1_score(y_true, preds, average="macro"),
        "y_true": y_true, "preds": preds, "probs": probs
    }

# -----------------------
# Train one config with early stopping on val balanced accuracy
# -----------------------
def train_once(hidden=(128,64,32), dropout=0.15, lr=1e-3, weight_decay=1e-4,
               batch_size=256, max_epochs=120, patience=15):
    train_loader, val_loader, _ = make_loaders(batch_size)
    model = MLP(in_dim=X_tr.shape[1], hidden=hidden, dropout=dropout).to(DEVICE)
    opt = torch.optim.Adam(model.parameters(), lr=lr, weight_decay=weight_decay)
    criterion = nn.BCEWithLogitsLoss(pos_weight=pos_weight) if pos_weight is not None else nn.BCEWithLogitsLoss()

    best_bacc = -1.0
    best_state = None
    wait = patience

    for epoch in range(1, max_epochs + 1):
        model.train()
        for xb, yb in train_loader:
            xb = xb.to(DEVICE); yb = yb.to(DEVICE)
            logits = model(xb)
            loss = criterion(logits, yb)
            opt.zero_grad(); loss.backward(); opt.step()

        val = evaluate(model, val_loader)
        print(f"Epoch {epoch:03d}/{max_epochs} | val_bacc={val['bacc']:.4f}  val_f1m={val['f1m']:.4f}  val_acc={val['acc']:.4f}")

        if val["bacc"] > best_bacc + 1e-5:
            best_bacc = val["bacc"]
            best_state = {k: v.detach().cpu().clone() for k, v in model.state_dict().items()}
            wait = patience
        else:
            wait -= 1
            if wait <= 0:
                print("Early stopping.")
                break

    if best_state is not None:
        model.load_state_dict(best_state)
    return model, best_bacc

