# -----------------------
# Inference helper: pass your usual X_input (1-row diff DataFrame)
# -----------------------
class _InferMLP(nn.Module):
    def __init__(self, in_dim, hidden, dropout):
        super().__init__()
        layers, prev = [], in_dim
        for h in hidden:
            layers += [nn.Linear(prev, h), nn.BatchNorm1d(h), nn.ReLU(), nn.Dropout(dropout)]
            prev = h
        layers += [nn.Linear(prev, 1)]
        self.net = nn.Sequential(*layers)
    def forward(self, x): return self.net(x).squeeze(1)

def predict_proba_torch(X_input_df: pd.DataFrame) -> np.ndarray:
    """
    X_input_df: DataFrame with exactly the columns in `diff_features` (same order enforced below).
    Returns: np.ndarray of shape (N,) with Prob(Red/Fighter1 wins).
    """
    # load artifacts
    with open(META_PATH, "r") as f:
        meta = json.load(f)
    scaler = joblib.load(SCALER_PATH)
    state  = torch.load(MODEL_PATH, map_location=DEVICE)

    # enforce column order & transform
    X = X_input_df[meta["features"]].astype(float).values
    X = scaler.transform(X)
    xb = torch.tensor(X, dtype=torch.float32, device=DEVICE)

    # build model & predict
    model = _InferMLP(meta["input_dim"], tuple(meta["hidden"]), meta["dropout"])
    model.load_state_dict(state); model.to(DEVICE); model.eval()
    with torch.no_grad():
        probs = torch.sigmoid(model(xb)).cpu().numpy()
    return probs

